# LLM — pick ONE provider. Free option: GEMINI_API_KEY from https://aistudio.google.com/apikey (no card needed).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Cost assumptions (USD per million tokens) — ASSUMPTION: set from the current Anthropic price sheet
LLM_INPUT_USD_PER_MTOK=3
LLM_OUTPUT_USD_PER_MTOK=15
# Voice assumptions — ASSUMPTION: Vaani per-minute rate is not in the case; set from the Vaani plan
VOICE_USD_PER_MIN=0.10
USD_INR=88
# Handoff (Telegram). If unset, handoff runs in dry-run mode and is logged on the dashboard.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Vaani webhook shared secret (adapter stub)
VAANI_WEBHOOK_SECRET=
